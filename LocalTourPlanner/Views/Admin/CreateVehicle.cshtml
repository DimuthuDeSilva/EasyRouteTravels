@model VehicleModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center mb-4">
                        <a asp-action="ManageVehicles" class="btn btn-link text-decoration-none p-0 me-3">
                            <i class="bi bi-arrow-left fs-4"></i>
                        </a>
                        <h2 class="fw-bold mb-0">@(Model == null || Model.VID == 0 ? "Add New Vehicle" : "Edit Vehicle Details")</h2>
                    </div>

                    <form asp-action="@(Model == null || Model.VID == 0 ? "CreateVehicle" : "EditVehicle")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="VID" />

                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Vehicle Display Name</label>
                                <input asp-for="VehicleName" class="form-control rounded-pill py-2" placeholder="e.g. Luxury Sedan, Mini Bus" required />
                                <span asp-validation-for="VehicleName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Vehicle Type</label>
                                <select asp-for="VehicleType" class="form-select rounded-pill py-2">
                                    <option value="Car">Car</option>
                                    <option value="Van">Van</option>
                                    <option value="Bus">Bus</option>
                                    <option value="SUV">SUV</option>
                                    <option value="TukTuk">Tuk-Tuk</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Passenger Capacity</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white rounded-start-pill"><i class="bi bi-people"></i></span>
                                    <input asp-for="SeatingCapacity" class="form-control rounded-end-pill py-2" type="number" />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Rate per Kilometer (LKR)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white rounded-start-pill text-muted">Rs.</span>
                                    <input asp-for="Rate" class="form-control rounded-end-pill py-2 fw-bold text-primary" type="number" step="0.01" />
                                </div>
                                <div class="form-text">This rate will be used to calculate total tour costs.</div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                                <i class="bi bi-check2-circle me-2"></i> Save Vehicle
                            </button>
                            <a asp-action="ManageVehicles" class="btn btn-light btn-lg rounded-pill px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>