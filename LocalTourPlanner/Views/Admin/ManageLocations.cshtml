@model IEnumerable<LocalTourPlanner.Domain.Location>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <h2 class="fw-bold text-dark mb-0">Location Management</h2>
            <p class="text-muted">Add, update, or remove destinations from the explorer.</p>
        </div>
        <a asp-action="CreateLocation" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Add New Location
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Preview</th>
                    <th>Location Name</th>
                    <th>Category</th>
                    <th>Distance</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="rounded-3 overflow-hidden" style="width: 60px; height: 45px; background-color: #eee;">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" class="w-100 h-100" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-muted small"></i>
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="fw-bold">@item.LocationName</td>
                        <td>
                            <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-3">
                                @item.Category
                            </span>
                        </td>
                        <td class="text-muted small">@item.Distance km</td>
                        <td class="text-end pe-4">
                            <a asp-action="EditLocation" asp-route-id="@item.LID" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="DeleteLocation" asp-route-id="@item.LID" method="post" style="display:inline;" onsubmit="return confirm('Are you sure? This will also remove the location from all user plans.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 3 seconds
        setTimeout(function () {
            var alert = document.querySelector('.alert');
            if (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 3000);
    </script>
}