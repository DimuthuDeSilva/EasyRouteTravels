@model IEnumerable<VehicleModel>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <h2 class="fw-bold text-dark mb-0">Fleet Management</h2>
            <p class="text-muted">Manage available transport options and pricing.</p>
        </div>
        <a asp-action="CreateVehicle" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Add New Vehicle
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Vehicle Name</th>
                    <th>Type</th>
                    <th>Rate (per km)</th>
                    <th>Capacity</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@item.VehicleName</td>
                        <td><span class="badge bg-secondary-subtle text-secondary px-3">@item.VehicleType</span></td>
                        <td class="text-primary fw-bold">LKR @item.Rate</td>
                        <td><i class="bi bi-people me-1"></i> @item.SeatingCapacity</td>
                        <td class="text-end pe-4">
                            <a asp-action="EditVehicle" asp-route-id="@item.VID" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="DeleteVehicle" asp-route-id="@item.VID" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to remove this vehicle from the fleet?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 3 seconds
        setTimeout(function () {
            var alert = document.querySelector('.alert');
            if (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 3000);
    </script>
}