@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LocalTourPlanner</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LocalTourPlanner.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center text-primary fw-bold" href="/">
                    <i class="bi bi-geo-alt-fill me-2"></i> EasyRoute Travels
                </a>

                <div class="search-container flex-grow-1 mx-4 d-none d-md-block">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input id="mainSearch" type="text" class="form-control rounded-pill ps-5" placeholder="Search locations...">
                    </div>
                </div>

                <div class="navbar-nav">
                    @{
                        var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
                        var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
                    }

                    @if (userName != null)
                    {
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i> Hi, @userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a class="dropdown-item" asp-controller="Tour" asp-action="MyPlan">
                                        <i class="bi bi-journal-text me-2"></i> My Plans
                                    </a>
                                </li>

                                @* --- ADMIN ONLY SECTION --- *@
                                @if (userRole == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Vehicle" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2"></i> Fleet Management
                                        </a>
                                    </li>
                                }
                                @* --------------------------- *@

                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-muted" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link text-primary fw-bold" asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - LocalTourPlanner
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>