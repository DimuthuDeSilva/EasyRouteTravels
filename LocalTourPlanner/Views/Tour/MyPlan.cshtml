@model IEnumerable<TourPlanModel>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "My Tour Plan";
}

<div class="container my-5">
    @* Success/Warning Messages *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* MAP *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <h4 class="fw-bold mb-3">Your Route Map</h4>
            <div id="map" style="height: 500px; width: 100%; border-radius: 12px;"></div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold m-0">My Selected Locations</h2>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill">
                    <i class="bi bi-plus-lg"></i> Add More
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                    <div class="card-body">
                        <i class="bi bi-geo-alt text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 text-muted">No locations added yet</h4>
                        <p>Browse our beautiful destinations and start planning your journey.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Explore Locations</a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="d-flex align-items-center">
                                <div style="width: 120px; height: 100px; background-color: #f8f9fa;">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" class="w-100 h-100" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-image text-secondary"></i>
                                        </div>
                                    }
                                </div>
                                <div class="p-3 flex-grow-1">
                                    <h5 class="fw-bold mb-1">@item.LocationName</h5>
                                    <div class="d-flex gap-3 text-muted small">
                                        <span><i class="bi bi-tag me-1"></i> @item.Category</span>
                                        <span><i class="bi bi-geo-alt me-1"></i> @item.Distance km</span>
                                    </div>
                                </div>
                                <div class="p-3">
                                    @* The form points to the RemoveFromPlan action *@
                                    <form asp-controller="Tour" asp-action="RemoveFromPlan" method="post">
                                        @* Pass the PlanID of THIS specific item *@
                                        <input type="hidden" name="planId" value="@item.PlanID" />

                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle"
                                                onclick="return confirm('Are you sure you want to remove this location?');">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @* Summary Sidebar *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Tour Summary</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total Locations</span>
                        <span class="fw-bold">@Model.Count()</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Estimated Distance</span>
                        <span class="fw-bold">@Model.Sum(x => x.Distance ?? 0) km</span>
                    </div>

                    <hr />

                    <p class="text-muted small">Next step: Choose your preferred vehicle to see the estimated travel cost.</p>

                    @if (Model.Any())
                    {
                        <a asp-controller="Vehicle" asp-action="Index" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm">
                            Choose Vehicle <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 rounded-pill py-2 fw-bold" disabled>
                            Choose Vehicle
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


@* ================= GOOGLE MAP ================= *@

<script>
    var locations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Model,
                                new System.Text.Json.JsonSerializerOptions
                                {
                                            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                                }
                ));

    let map;
    let directionsService;
    let directionsRenderer;

    function initMap() {

        map = new google.maps.Map(document.getElementById("map"), {
            zoom: 8,
            center: { lat: 7.8731, lng: 80.7718 }
        });

        directionsService = new google.maps.DirectionsService();
        directionsRenderer = new google.maps.DirectionsRenderer({ map: map });

        if (!locations || locations.length === 0) return;

        let waypoints = [];

        locations.forEach(x => {
            if (x.latitude && x.longitude) {
                waypoints.push({
                    location: new google.maps.LatLng(x.latitude, x.longitude),
                    stopover: true
                });
            }
        });

        if (waypoints.length === 0) return;

        // ONLY ONE LOCATION → marker
        if (waypoints.length === 1) {
            new google.maps.Marker({
                position: waypoints[0].location,
                map: map
            });
            return;
        }

        let request = {
            origin: waypoints[0].location,
            destination: waypoints[waypoints.length - 1].location,
            waypoints: waypoints.slice(1, -1),
            travelMode: google.maps.TravelMode.DRIVING
        };

        directionsService.route(request, function (result, status) {
            if (status === "OK") {
                directionsRenderer.setDirections(result);
            } else {
                console.error("Google Route Error:", status);
            }
        });
    }
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=@(Configuration["GoogleMaps:ApiKey"])&callback=initMap"
        async defer></script>