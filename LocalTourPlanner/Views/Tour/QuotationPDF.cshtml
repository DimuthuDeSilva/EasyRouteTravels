@model CostBreakdownViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Trip Quotation</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
            margin: 0;
            padding: 30px;
            background: #fff;
        }

        .container {
            max-width: 800px;
            margin: auto;
        }

        /* Header */
        .header {
            text-align: center;
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

            .header h1 {
                margin: 0;
                color: #0d6efd;
            }

            .header p {
                margin: 5px 0 0;
                font-size: 14px;
                color: #555;
            }

        /* Section titles */
        .section-title {
            background: #f0f7ff;
            color: #0d6efd;
            padding: 8px 12px;
            font-weight: bold;
            border-left: 4px solid #0d6efd;
            margin-top: 25px;
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th {
            text-align: left;
            background: #f8f9fa;
            padding: 10px;
            font-size: 14px;
            border-bottom: 2px solid #dee2e6;
        }

        td {
            padding: 10px;
            font-size: 14px;
            border-bottom: 1px solid #eee;
        }

        /* Summary box */
        .summary-box {
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 14px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: bold;
            color: #0d6efd;
            border-top: 2px solid #0d6efd;
            padding-top: 10px;
            margin-top: 10px;
        }

        /* Footer */
        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #777;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }

        /* Print button */
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }

        /* Print optimization */
        @@media print {
            .print-btn {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <!-- Header -->
        <div class="header">
            <h1>EasyRoute Travels</h1>
            <p>Trip Quotation & Itinerary Summary</p>
        </div>

        <!-- Selected Destinations -->
        <div class="section-title">Selected Destinations</div>
        <table>
            <thead>
                <tr>
                    <th>Location</th>
                    <th>Category</th>
                    <th style="text-align: right;">Distance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loc in Model.SelectedLocations)
                {
                    <tr>
                        <td>@loc.LocationName</td>
                        <td>@loc.Category</td>
                        <td style="text-align: right;">@loc.Distance km</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Transport Details -->
        <div class="section-title">Transport Details</div>
        <table>
            <tr>
                <th width="30%">Vehicle</th>
                <td>@Model.SelectedVehicleName</td>
            </tr>
            <tr>
                <th>Base Rate</th>
                <td>$@Model.RatePerKm per km</td>
            </tr>
        </table>

        <!-- Summary -->
        <div class="summary-box">
            <div class="summary-row">
                <span>Total Travel Distance (including return)</span>
                <span><strong>@Model.TotalDistance km</strong></span>
            </div>

            <div class="total-row">
                <span>GRAND TOTAL</span>
                <span>$@Model.GrandTotal.ToString("N2")</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>Generated on @Model.GeneratedDate. Valid for 7 days.</p>
            <p>Email: support@easyroute.com | Web: www.easyroute.com</p>
        </div>

        <!-- Print Button -->
        <div class="print-btn">
            <button onclick="window.print()">Print Report</button>
        </div>

    </div>
</body>
</html>